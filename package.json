{
  "name": "habitar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-estate exploration in 3D: a live map of the city, buildings that exist or not, and units you can live in before buying.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:osm": "node scripts/fetch-osm.mjs",
    "assets:polyhaven": "node scripts/fetch-polyhaven.mjs",
    "unit:optimize": "node scripts/optimize-glb.mjs",
    "unit:lightmaps": "node scripts/optimize-lightmaps.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "3d-tiles-renderer": "^0.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
