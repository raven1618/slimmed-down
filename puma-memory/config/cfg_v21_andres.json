   "name": "INTRO",
   "vo": "—",
   "sides": "La luz entra desde los dos costados y recorre el contorno del troquel",
   "centre": "Se enciende el verde del KV + logo",
   "light": "Desde ambos costados hacia el centro",
   "sfx": "Viaje de luz + golpe grave al encender"
  },
  {
   "a": 1.6,
   "b": 7.48,
   "name": "PLACA 1 · BOTINES",
   "vo": "«Los grandes resultados… no empiezan en la cancha.»",
   "sides": "UNA imagen en toda la pantalla (1,4 s); después la misma imagen sigue a los costados",
   "centre": "La luz trae una sombra suave detrás del texto (sin bloque verde) → LOS GRANDES RESULTADOS → NO EMPIEZAN EN LA CANCHA",
   "light": "Nace en los cordones → golpe; luego entra desde el costado derecho → golpe",
   "sfx": "Barrido de entrada, nacimiento de la luz, 2 impactos graves (sin campanita), eco de túnel bajo"
  },
  {
   "a": 7.48,
   "b": 12.48,
   "name": "PLACA 2 · CONCENTRACIÓN",
   "vo": "«Empiezan… en la mente.»",
   "sides": "Imagen extendida con IA a 21:9: la escena sigue a los costados (sin recortes ni repeticiones) + verde del KV muy suave en los laterales",
   "centre": "EMPIEZAN → EN LA MENTE",
   "light": "Nace en la sien → golpe; luego desde el costado derecho → golpe",
   "sfx": "Barrido, latido/respiración bajos, 2 impactos graves (sin campanita)"
  },
  {
   "a": 12.48,
   "b": 17.48,
   "name": "PLACA 3 · HUDDLE",
   "vo": "«Con líderes… que inspiran.»",
   "sides": "Imagen extendida con IA a 21:9: la escena sigue a los costados (sin recortes ni repeticiones) + verde del KV muy suave en los laterales",
   "centre": "CON LÍDERES → QUE INSPIRAN",
   "light": "Nace en el dedo del capitán → golpe; luego desde el costado izquierdo → golpe",
   "sfx": "Barrido, tribuna baja, 2 impactos graves (sin campanita)"
  },
  {
   "a": 17.48,
   "b": 23.6,
   "name": "PLACA 4 · COMPAÑERISMO",
   "vo": "«Y entienden que ninguna victoria se consigue solo.»",
   "sides": "Imagen extendida con IA a 21:9: la escena sigue a los costados (sin recortes ni repeticiones) + verde del KV muy suave en los laterales",
   "centre": "Y ENTIENDEN QUE / NINGUNA VICTORIA / SE CONSIGUE SOLO (3 golpes)",
   "light": "Nace en las manos → golpe; desde la derecha → golpe; desde los dos costados → golpe; la luz se vuelve la pelota del KV",
   "sfx": "Barrido, tribuna que crece, 3 impactos, subida al destello"
